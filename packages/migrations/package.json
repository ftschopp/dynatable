{
  "name": "@ftschopp/dynatable-migrations",
  "version": "1.0.0",
  "description": "DynamoDB migration tool for single table design with schema versioning",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dynatable-migrate": "./bin/dynatable-migrate.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "USAGE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "lint": "eslint src",
    "test": "jest",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "dynamodb",
    "migrations",
    "single-table-design",
    "schema-versioning",
    "cli"
  ],
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.7.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/lib-dynamodb": "^3.1092.0",
    "commander": "^14.0.3"
  },
  "peerDependencies": {
    "ts-node": "^10.9.0",
    "typescript": ">=4.5"
  },
  "peerDependenciesMeta": {
    "ts-node": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
